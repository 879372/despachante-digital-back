# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# Banco (deixe vazio para SQLite). Ex.: postgres://usuario:senha@localhost:5432/despachante
DATABASE_URL=

# --- Fonte de dados (NUNCA vai para o frontend) ---
FONTE_API_URL=https://api.buscars.com.br
FONTE_API_KEY=bk_live_COLE_SUA_CHAVE_AQUI
# Segredo exibido uma única vez ao cadastrar o webhook no painel do fornecedor
FONTE_WEBHOOK_SECRET=
# Parte aleatória da URL do webhook: /api/retorno/<este-token>/
WEBHOOK_TOKEN_ROTA=gere-um-token-aleatorio-aqui

# Devolver o valor ao cliente quando a emissão falhar (1 = sim)
ESTORNAR_FALHAS=1

# --- Programa de indicação ---
BONUS_INDICACAO_CENTAVOS=500
# primeira_recarga = bônus liberado no 1º pagamento confirmado do indicado (recomendado)
# cadastro         = bônus liberado assim que o indicado cria a conta
BONUS_INDICACAO_GATILHO=primeira_recarga

# --- E-mail / recuperação de senha (Resend via API HTTPS · kaibez.com.br) ---
FRONTEND_URL=http://localhost:5173
# Opcional. Vazio = sem e-mail de contato (suporte pelo chat interno)
SUPORTE_EMAIL=
EMAIL_REMETENTE=Despachante Digital <nao-responda@kaibez.com.br>
# Cole aqui a API key do Resend (começa com re_). Sem chave, produção não envia e-mails.
EMAIL_SENHA=
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USUARIO=resend

# --- Pagamento online · InfinitePay Checkout Integrado ---
# InfiniteTag sem o $ (Conta Web > Configurações do Checkout)
INFINITEPAY_HANDLE=
# API Key (começa com inchk_). Opcional, mas recomendada: permite link de uso único que expira.
INFINITEPAY_API_KEY=
# URL pública HTTPS do backend (ex.: https://api.seudominio.com.br). Vazio em dev.
INFINITEPAY_WEBHOOK_BASE=
INFINITEPAY_WEBHOOK_TOKEN=gere-um-token-aleatorio
INFINITEPAY_VALIDADE_HORAS=2

# --- Armazenamento de arquivos · S3 privado ---
# Com S3_BUCKET preenchido, PDFs/comprovantes/anexos vão para o bucket (MEDIA_ROOT deixa de ser usado).
S3_BUCKET=
S3_REGIAO=sa-east-1
S3_PREFIXO=privado
# Usuário IAM com acesso SOMENTE a este bucket (política no README)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Só para provedores compatíveis (Cloudflare R2, Backblaze...). Vazio = AWS.
S3_ENDPOINT=
